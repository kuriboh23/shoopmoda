# Aucun script ne doit jamais s'exécuter depuis ce dossier.
Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|phar|php\d|cgi|pl|py|sh|htm|html|svg|xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .phar

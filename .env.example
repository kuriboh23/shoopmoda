# ------------------------------------------------------------------
# Shoop Moda Style - variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs.
# Le fichier `.env` ne doit JAMAIS etre commite.
# ------------------------------------------------------------------

# Application
APP_NAME="Shoop Moda Style"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votre-domaine.ma

# Boutique
CURRENCY=DH
WHATSAPP_NUMBER=212725605520

# Chemin secret de l'administration (sans slash)
# Exemple: /gestion-shoop-8f2  ->  ADMIN_PATH=gestion-shoop-8f2
ADMIN_PATH=gestion

# Secret de signature des cookies (64 caracteres aleatoires)
# Generer avec: php -r "echo bin2hex(random_bytes(32));"
COOKIE_SECRET=

# Base de donnees MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shoopmoda
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
